<section class="heritage-trust-row section" style="--heritage-trust-background: {{ section.settings.background }}">
  <div class="section--page-width heritage-trust-row__inner">
    {% if section.settings.kicker != blank or section.settings.heading != blank %}
      <header class="heritage-trust-row__header">
        {% if section.settings.kicker != blank %}<p class="heritage-kicker">{{ section.settings.kicker }}</p>{% endif %}
        {% if section.settings.heading != blank %}<h2 class="heritage-section-heading">{{ section.settings.heading }}</h2>{% endif %}
      </header>
    {% endif %}

    <div class="heritage-trust-row__grid">
      {% for block in section.blocks %}
        {% liquid
          assign item_tag = 'div'
          if block.settings.link != blank
            assign item_tag = 'a'
          endif
        %}
        <{{ item_tag }} class="heritage-trust-item" {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %} {{ block.shopify_attributes }}>
          <span class="heritage-trust-item__icon" aria-hidden="true">
            {% case block.settings.icon %}
              {% when 'sparkle' %}
                <svg viewBox="0 0 24 24" fill="none"><path d="M12 2c.5 5.6 4.4 9.5 10 10-5.6.5-9.5 4.4-10 10-.5-5.6-4.4-9.5-10-10 5.6-.5 9.5-4.4 10-10Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
              {% when 'globe' %}
                <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/><path d="M3.5 9h17M3.5 15h17M12 3c2.2 2.5 3.3 5.5 3.3 9S14.2 18.5 12 21c-2.2-2.5-3.3-5.5-3.3-9S9.8 5.5 12 3Z" stroke="currentColor" stroke-width="1.5"/></svg>
              {% when 'shield' %}
                <svg viewBox="0 0 24 24" fill="none"><path d="M12 3 20 6v5.4c0 4.6-3.2 8.2-8 9.6-4.8-1.4-8-5-8-9.6V6l8-3Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="m8.5 12 2.2 2.2 4.8-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {% when 'support' %}
                <svg viewBox="0 0 24 24" fill="none"><path d="M4 13v-2a8 8 0 0 1 16 0v2M4 13H2.8A.8.8 0 0 0 2 13.8v3.4a.8.8 0 0 0 .8.8H4a2 2 0 0 0 2-2v-1a2 2 0 0 0-2-2Zm16 0h1.2a.8.8 0 0 1 .8.8v3.4a.8.8 0 0 1-.8.8H20a2 2 0 0 1-2-2v-1a2 2 0 0 1 2-2ZM18 18c-1 2-2.8 3-5.5 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              {% else %}
                <svg viewBox="0 0 24 24" fill="none"><path d="M4 9h16v12H4V9Zm-1-4h18v4H3V5Zm9 0v16M7.2 5C5.6 3.2 6.8 1.8 8.3 2.2 10 2.6 11 5 12 5m4.8 0c1.6-1.8.4-3.2-1.1-2.8C14 2.6 13 5 12 5" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
            {% endcase %}
          </span>
          <span class="heritage-trust-item__content">
            <span class="heritage-trust-item__heading">{{ block.settings.heading }}</span>
            {% if block.settings.text != blank %}<span class="heritage-trust-item__text">{{ block.settings.text }}</span>{% endif %}
          </span>
        </{{ item_tag }}>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Heritage trust row",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "color", "id": "background", "label": "Background", "default": "#F8F3EA" }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Trust signal",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "gift", "label": "Gift" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "globe", "label": "Globe" },
            { "value": "shield", "label": "Shield" },
            { "value": "support", "label": "Support" }
          ],
          "default": "gift"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Gift-ready packaging"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Beautifully presented with care"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Heritage trust row",
      "blocks": [
        { "type": "trust" },
        { "type": "trust" },
        { "type": "trust" },
        { "type": "trust" }
      ]
    }
  ]
}
{% endschema %}
