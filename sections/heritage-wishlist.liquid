<section
  class="heritage-wishlist-page section section--page-width"
  data-heritage-wishlist-page
  data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
  data-locale="{{ request.locale.iso_code | default: 'en-US' }}"
  data-add-label="Add to wishlist"
  data-remove-label="Remove from wishlist"
  data-add-to-bag="{{ 'products.product.add_to_cart' | t | escape }}"
  data-sold-out="{{ 'products.product.sold_out' | t | escape }}"
>
  <header class="heritage-wishlist-page__header">
    <p class="heritage-kicker">Saved with care</p>
    <h1 class="heritage-section-heading">{{ section.settings.heading }}</h1>
    <p class="heritage-section-copy">{{ section.settings.description }}</p>
  </header>

  <div class="heritage-wishlist-grid" data-wishlist-grid></div>

  <div class="heritage-wishlist-empty" data-wishlist-empty hidden>
    <h2>Your wishlist is waiting</h2>
    <p>Save thoughtful finds here and return whenever the moment is right.</p>
    <a class="button" href="{{ routes.all_products_collection_url }}">
      {{ 'actions.continue_shopping' | t }}
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Heritage wishlist",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your wishlist"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "A quiet place for thoughtful gifts you would love to return to."
    }
  ],
  "presets": [
    {
      "name": "Heritage wishlist"
    }
  ]
}
{% endschema %}
