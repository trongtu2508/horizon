<section class="heritage-editorial{% if section.settings.reverse %} heritage-editorial--reverse{% endif %} section section--page-width">
  <div class="heritage-editorial__inner" style="background: {{ section.settings.background }}">
    <div class="heritage-editorial__media">
      {% if section.settings.image %}
        {{
          section.settings.image
          | image_url: width: 1800
          | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1500, 1800'
        }}
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      {% endif %}
    </div>
    <div class="heritage-editorial__content">
      <p class="heritage-kicker">{{ section.settings.kicker }}</p>
      <h2 class="heritage-section-heading">{{ section.settings.heading }}</h2>
      <div class="rte">{{ section.settings.text }}</div>
      {% if section.settings.button_label != blank and section.settings.button_link != blank %}
        <a class="button" href="{{ section.settings.button_link }}">
          {{ section.settings.button_label }}
        </a>
      {% elsif request.design_mode and section.settings.button_label != blank %}
        <p class="heritage-editor-empty">Choose a button link to publish this call to action.</p>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Heritage editorial",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#CBD8C8"
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "Image on the right",
      "default": false
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "A thoughtful gesture"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made meaningful by the way it is given"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Every piece is selected for lasting beauty, presented with warmth, and ready to become part of someone's story.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Discover our story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Heritage editorial"
    }
  ]
}
{% endschema %}
