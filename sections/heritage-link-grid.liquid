{% liquid
  assign rendered_cards = 0
%}

<section class="heritage-link-grid section section--page-width">
  <header class="heritage-link-grid__header">
    {% if section.settings.kicker != blank %}<p class="heritage-kicker">{{ section.settings.kicker }}</p>{% endif %}
    <h2 class="heritage-section-heading">{{ section.settings.heading }}</h2>
    {% if section.settings.description != blank %}
      <p class="heritage-section-copy">{{ section.settings.description }}</p>
    {% endif %}
  </header>

  <div
    class="heritage-link-grid__items heritage-link-grid__items--mobile-{{ section.settings.mobile_layout }}"
    style="--heritage-columns: {{ section.settings.columns }}"
  >
    {% for block in section.blocks %}
      {% liquid
        assign selected_collection = block.settings.collection
        assign destination = block.settings.link
        assign card_image = block.settings.image
        assign card_title = block.settings.title
        assign show_card = true

        if destination == blank and selected_collection != blank
          assign destination = selected_collection.url
        endif
        if card_image == blank and selected_collection != blank
          assign card_image = selected_collection.image
        endif
        if card_title == blank and selected_collection != blank
          assign card_title = selected_collection.title
        endif

        if destination == blank or card_image == blank
          assign show_card = false
        endif
        if block.settings.link == blank and selected_collection != blank and selected_collection.products_count == 0
          assign show_card = false
        endif
        if request.design_mode
          assign show_card = true
        endif
      %}

      {% if show_card %}
        {% assign rendered_cards = rendered_cards | plus: 1 %}
        <a
          class="heritage-link-card{% if destination == blank %} heritage-link-card--disabled{% endif %}"
          {% if destination != blank %}href="{{ destination }}"{% endif %}
          {{ block.shopify_attributes }}
        >
          {% if card_image %}
            {{
              card_image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                class: 'heritage-link-card__media',
                widths: '360, 540, 720, 900, 1200',
                sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 78vw'
            }}
          {% else %}
            <span class="heritage-link-card__placeholder" aria-hidden="true"></span>
          {% endif %}
          <span class="heritage-link-card__content">
            <span class="heritage-link-card__title">{{ card_title | default: 'Add a title' }}</span>
            {% if block.settings.subtitle != blank %}<span>{{ block.settings.subtitle }}</span>{% endif %}
            {% if request.design_mode and destination == blank %}
              <span class="heritage-link-card__editor-note">Choose a collection or link</span>
            {% elsif request.design_mode and selected_collection != blank and selected_collection.products_count == 0 %}
              <span class="heritage-link-card__editor-note">This collection is empty</span>
            {% endif %}
          </span>
        </a>
      {% endif %}
    {% endfor %}
  </div>

  {% if request.design_mode and rendered_cards == 0 %}
    <p class="heritage-editor-empty">Add images and collection links to publish this section.</p>
  {% endif %}
</section>

{% schema %}
{
  "name": "Heritage link grid",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Find the right moment" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by occasion" },
    { "type": "textarea", "id": "description", "label": "Description" },
    { "type": "range", "id": "columns", "label": "Desktop columns", "min": 2, "max": 6, "step": 1, "default": 3 },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        { "value": "carousel", "label": "Horizontal carousel" },
        { "value": "grid", "label": "Two-column grid" }
      ],
      "default": "carousel"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link card",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "link", "label": "Link override", "info": "Overrides the selected collection link." },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Uses the collection image when left blank." },
        { "type": "text", "id": "title", "label": "Title", "default": "Birthday" },
        { "type": "text", "id": "subtitle", "label": "Subtitle" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Heritage link grid",
      "blocks": [
        { "type": "link" },
        { "type": "link" },
        { "type": "link" }
      ]
    }
  ]
}
{% endschema %}
