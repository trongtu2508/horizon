<script src="{{ 'heritage-mega-navigation.js' | asset_url }}" type="module" fetchpriority="low"></script>

{% render 'contrast-override',
  background_color: section.settings.background_color,
  text_color: section.settings.text_color,
  section_id: section.id
%}

<div class="section-background color-custom-{{ section.id }}"></div>
<heritage-mega-navigation
  class="heritage-mega-nav color-custom-{{ section.id }}"
  style="--heritage-mega-nav-border: {{ section.settings.border_color }};"
  data-section-id="{{ section.id }}"
>
  <nav class="heritage-mega-nav__bar section section--{{ section.settings.section_width }}" aria-label="Primary navigation">
    <ul class="heritage-mega-nav__items list-unstyled">
      {% for block in section.blocks %}
        {% liquid
          assign item_menu = block.settings.menu
          assign item_label = block.settings.label | default: item_menu.title
          assign item_url = block.settings.link | default: routes.all_products_collection_url
        %}
        <li class="heritage-mega-nav__item{% if block.settings.highlight %} heritage-mega-nav__item--highlight{% endif %}" {{ block.shopify_attributes }}>
          {% if item_menu != blank and item_menu.links.size > 0 %}
            <details data-mega-details>
              <summary class="heritage-mega-nav__trigger">
                <span>{{ item_label }}</span>
                <svg aria-hidden="true" viewBox="0 0 10 6" fill="none"><path d="m1 1 4 4 4-4" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </summary>

              <div class="heritage-mega-nav__dropdown">
                <div class="heritage-mega-nav__dropdown-inner section section--page-width">
                  <a class="heritage-mega-nav__view-all" href="{{ item_url }}">
                    <span>View all {{ item_label }}</span>
                    <svg aria-hidden="true" viewBox="0 0 12 12" fill="none"><path d="m4.5 2.25 3.5 3.75-3.5 3.75" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </a>

                  <div class="heritage-mega-nav__content{% if block.settings.promo_image != blank or block.settings.promo_heading != blank %} heritage-mega-nav__content--with-promo{% endif %}">
                    <div class="heritage-mega-nav__columns">
                      {% for column in item_menu.links %}
                        <div class="heritage-mega-nav__column">
                          <a class="heritage-mega-nav__heading" href="{{ column.url }}">{{ column.title }}</a>
                          {% if column.links != blank %}
                            <ul class="heritage-mega-nav__links list-unstyled">
                              {% for child_link in column.links %}
                                <li>
                                  <a href="{{ child_link.url }}">{{ child_link.title }}</a>
                                  {% if child_link.links != blank %}
                                    <ul class="heritage-mega-nav__nested list-unstyled">
                                      {% for grandchild_link in child_link.links %}
                                        <li><a href="{{ grandchild_link.url }}">{{ grandchild_link.title }}</a></li>
                                      {% endfor %}
                                    </ul>
                                  {% endif %}
                                </li>
                              {% endfor %}
                            </ul>
                          {% endif %}
                        </div>
                      {% endfor %}
                    </div>

                    {% if block.settings.promo_image != blank or block.settings.promo_heading != blank %}
                      <aside class="heritage-mega-nav__promo">
                        <a class="heritage-mega-nav__promo-card" href="{{ block.settings.promo_link | default: item_url }}">
                          {% if block.settings.promo_image != blank %}
                            {{ block.settings.promo_image | image_url: width: 720 | image_tag: class: 'heritage-mega-nav__promo-image', loading: 'lazy', widths: '240, 360, 540, 720' }}
                          {% endif %}
                          {% if block.settings.promo_heading != blank or block.settings.promo_text != blank %}
                            <span class="heritage-mega-nav__promo-copy">
                              {% if block.settings.promo_heading != blank %}<strong>{{ block.settings.promo_heading }}</strong>{% endif %}
                              {% if block.settings.promo_text != blank %}<span>{{ block.settings.promo_text }}</span>{% endif %}
                            </span>
                          {% endif %}
                        </a>
                        {% if block.settings.promo_link_label != blank %}
                          <a class="heritage-mega-nav__promo-link" href="{{ block.settings.promo_link | default: item_url }}">{{ block.settings.promo_link_label }}</a>
                        {% endif %}
                      </aside>
                    {% endif %}
                  </div>
                </div>
              </div>
            </details>
          {% else %}
            <a class="heritage-mega-nav__trigger" href="{{ item_url }}">{{ item_label }}</a>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </nav>
</heritage-mega-navigation>

{% stylesheet %}
  .heritage-mega-nav {
    position: relative;
    z-index: var(--layer-menu-drawer);
    display: block;
    border-bottom: 1px solid var(--heritage-mega-nav-border, rgb(var(--color-foreground-rgb) / 0.2));
    background: var(--color-background);
  }

  .heritage-mega-nav__bar {
    min-height: 46px;
  }

  .heritage-mega-nav__items {
    display: flex;
    align-items: stretch;
    justify-content: center;
    min-height: 46px;
    margin: 0;
  }

  .heritage-mega-nav__item,
  .heritage-mega-nav__item details {
    position: static;
  }

  .heritage-mega-nav__item details[open] .heritage-mega-nav__trigger,
  .heritage-mega-nav__item--highlight .heritage-mega-nav__trigger {
    color: var(--color-primary-button-background);
  }

  .heritage-mega-nav__trigger {
    position: relative;
    display: flex;
    align-items: center;
    gap: 5px;
    min-height: 46px;
    padding-inline: clamp(12px, 1.35vw, 22px);
    color: inherit;
    font-family: var(--font-body--family);
    font-size: 13px;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    list-style: none;
  }

  .heritage-mega-nav__trigger::-webkit-details-marker {
    display: none;
  }

  .heritage-mega-nav__trigger > svg {
    width: 9px;
    height: 6px;
    opacity: 0;
    transition: opacity 150ms ease, transform 150ms ease;
  }

  .heritage-mega-nav__item:hover .heritage-mega-nav__trigger > svg,
  .heritage-mega-nav details[open] .heritage-mega-nav__trigger > svg {
    opacity: 1;
  }

  .heritage-mega-nav details[open] .heritage-mega-nav__trigger::after {
    content: '';
    position: absolute;
    right: 12px;
    bottom: 0;
    left: 12px;
    height: 2px;
    background: currentColor;
  }

  .heritage-mega-nav details[open] .heritage-mega-nav__trigger > svg {
    transform: rotate(180deg);
  }

  .heritage-mega-nav:has(details[open])::after {
    content: '';
    position: absolute;
    z-index: 1;
    top: 100%;
    right: 0;
    left: 0;
    height: 100vh;
    background: rgb(0 0 0 / 0.34);
    pointer-events: none;
  }

  .heritage-mega-nav__dropdown {
    position: absolute;
    z-index: 2;
    top: 100%;
    right: 0;
    left: 0;
    max-height: min(620px, calc(100vh - 150px));
    overflow-y: auto;
    border-top: 1px solid rgb(var(--color-foreground-rgb) / 0.16);
    background: var(--color-background);
    box-shadow: 0 14px 30px rgb(0 0 0 / 0.08);
  }

  .heritage-mega-nav__dropdown-inner {
    padding-block: 20px 32px;
  }

  .heritage-mega-nav__view-all {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 20px;
    color: var(--color-primary-button-background);
    font-size: 13px;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .heritage-mega-nav__view-all svg {
    width: 11px;
    height: 11px;
  }

  .heritage-mega-nav__content {
    display: grid;
  }

  .heritage-mega-nav__content--with-promo {
    grid-template-columns: minmax(0, 1fr) minmax(220px, 290px);
    gap: clamp(32px, 5vw, 76px);
  }

  .heritage-mega-nav__columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(135px, 1fr));
    gap: 24px clamp(24px, 3vw, 52px);
  }

  .heritage-mega-nav__heading {
    display: inline-flex;
    margin-bottom: 8px;
    color: inherit;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.3;
    text-decoration: none;
  }

  .heritage-mega-nav__links a,
  .heritage-mega-nav__nested a {
    display: inline-flex;
    padding-block: 5px;
    color: inherit;
    font-size: 13px;
    line-height: 1.35;
    text-decoration: none;
  }

  .heritage-mega-nav__heading:hover,
  .heritage-mega-nav__links a:hover,
  .heritage-mega-nav__nested a:hover {
    color: var(--color-primary-button-background);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .heritage-mega-nav__nested {
    margin: 0 0 3px 12px;
    opacity: 0.78;
  }

  .heritage-mega-nav__promo {
    display: flex;
    flex-direction: column;
    align-self: start;
  }

  .heritage-mega-nav__promo-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 210px;
    overflow: hidden;
    background: #f7f1ee;
    color: #24211f;
    text-align: center;
    text-decoration: none;
  }

  .heritage-mega-nav__promo-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .heritage-mega-nav__promo-copy {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px;
  }

  .heritage-mega-nav__promo-copy strong {
    font-family: var(--font-heading--family);
    font-size: 24px;
    line-height: 1.08;
  }

  .heritage-mega-nav__promo-copy span {
    font-size: 13px;
    line-height: 1.4;
  }

  .heritage-mega-nav__promo-link {
    align-self: center;
    margin-top: 10px;
    color: var(--color-primary-button-background);
    font-size: 13px;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .heritage-mega-nav {
      display: none;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .heritage-mega-nav__content--with-promo {
      grid-template-columns: minmax(0, 1fr) 220px;
      gap: 28px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mega navigation",
  "class": "heritage-mega-navigation-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#2F3035"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#D7D3D0"
    }
  ],
  "blocks": [
    {
      "type": "menu_item",
      "name": "Menu item",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Name",
          "info": "For example: Ornament"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Main link",
          "info": "Used by View all and when no menu is selected."
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "info": "Choose a menu created in Online Store > Navigation."
        },
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "Highlight this item",
          "default": false
        },
        {
          "type": "header",
          "content": "Promotion"
        },
        {
          "type": "image_picker",
          "id": "promo_image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "promo_heading",
          "label": "Heading"
        },
        {
          "type": "textarea",
          "id": "promo_text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "promo_link_label",
          "label": "Link label",
          "default": "Shop the collection"
        },
        {
          "type": "url",
          "id": "promo_link",
          "label": "Promotion link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mega navigation",
      "blocks": [
        { "type": "menu_item", "settings": { "label": "Home", "link": "/" } },
        { "type": "menu_item", "settings": { "label": "Catalog", "link": "shopify://collections/all" } },
        { "type": "menu_item", "settings": { "label": "Contact", "link": "shopify://pages/contact" } }
      ]
    }
  ]
}
{% endschema %}
